# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_PORT=5000
SECRET_KEY=nammaspeak-dev-secret-change-in-prod

# Database
DATABASE_PATH=instance/nammaspeak.db

# AI Provider Configuration
# Options: 'local' (default deterministic offline engine), 'gemini', or 'openai'
AI_PROVIDER=local
GEMINI_API_KEY=
# Optional: leave blank to select a stable generateContent model advertised for this key.
AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT=15
# Server-side Kannada pronunciation audio settings
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_TTS_TIMEOUT=15
